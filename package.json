{
  "name": "final-countdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web reincarnation of Final Countdown (Demonware, Amiga 1990) — intro + A9000 terminal slice.",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
